APP_NAME=Printing
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Version shown in the generated OpenAPI document.
API_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL. Create both databases once:
#   createdb printing_bags && createdb printing_bags_test
# The test database name is set in phpunit.xml, not here.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=printing_bags
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where product images are written. `public` locally; set to `s3` in production after
#   composer require league/flysystem-aws-s3-v3
# and filling in the AWS_* values below. Each image records its own disk, so switching
# affects new uploads only — existing images keep resolving from where they already live.
MEDIA_DISK=public
MEDIA_MAX_KILOBYTES=5120

# Payment receipts — the PDF proving a bank transfer landed. A **private** disk, unlike product
# images: a receipt carries a customer's bank details, and the `public` disk hands out permanent
# unauthenticated URLs. `local` is storage/app/private.
MEDIA_RECEIPTS_DISK=local
MEDIA_RECEIPT_MAX_KILOBYTES=10240

# The audit trail. Leave it on: every model records who created, changed, deleted or restored
# it, and the history endpoints read nothing else. Turning it off writes no entries at all — a
# gap that cannot be filled in afterwards — so the only honest reason is a bulk import nobody
# will ever want to read the history of.
ACTIVITYLOG_ENABLED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nawris — the Libyan last-mile carrier. Nothing here has a working default; dispatch refuses
# until the first two are filled in. NAWRIS_WEBHOOK_IPS is comma-separated and should be set in
# production: the bearer token alone guards an endpoint that moves orders and writes money.
NAWRIS_BASE_URL=https://backoffice.nawris.algoriza.com/external-api/
NAWRIS_AUTHENTICATION_KEY=
NAWRIS_MAIN_CLIENT_CODE=
NAWRIS_WEBHOOK_SECRET=
NAWRIS_WEBHOOK_IPS=
# The `shipping_companies` row a Nawris parcel is filed under — النورس itself, not whichever
# carrier the shop sends most parcels with. Left blank, the parcel falls back to the company
# marked `is_default`, so the order and its parcel never name two different carriers.
NAWRIS_SHIPPING_COMPANY_ID=
# Build the payload and log it without sending — see NAWRIS-INTEGRATION.md.
NAWRIS_DRY_RUN=false

# Firebase Cloud Messaging — push notifications (FCM HTTP v1).
# Nothing here has a working default: publishing still writes the in-app notification, and the
# push is simply skipped until these are filled in. FCM_CREDENTIALS_PATH points at the service
# account JSON, which is a private key — never commit it; copy it to each box like .env itself.
# Use a SEPARATE Firebase project per environment, or a push from a laptop reaches the shop's
# counter phone. See Docs/notifications/NOTIFICATIONS-BACKEND-CHANGES.md.
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
# Must match the notification channel the Flutter app creates, or Android 8+ drops it silently.
FCM_ANDROID_CHANNEL_ID=dayaa_default
# Writes storage/logs/fcm.log — «did we even try?» is the first question when a push is missing.
# Leave blank to log nothing. The service account key is never written here.
FCM_LOG_CHANNEL=fcm
# Build the payload and log it without sending — read the first live push before it leaves.
FCM_DRY_RUN=false
